		<StreamGeometry x:Key="icon-fluent-mdl2-copy">M1920 805v1243H640v-384H128V0h859l384 384h128zm-384-37h165l-165-165zM640 384h549L933 128H256v1408h384zm1152 512h-384V512H768v1408h1024z</StreamGeometry>
		<StreamGeometry x:Key="icon-fluent-mdl2-paste">M1920 768v1280H896v-128H128V256h512q0-52 20-99t55-81t81-55T896 0q52 0 99 20t81 55t55 82t21 99h512v512zM512 384v128h768V384h-256v-33q0-17 1-36q0-34-3-67t-17-60t-39-43t-70-17q-44 0-69 16t-39 43t-17 60t-4 68v35q0 17 1 34zm384 1408V768h640V384h-128v256H384V384H256v1408zm896-896h-768v1024h768z</StreamGeometry>
