<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net8.0-windows</TargetFramework>
		<RootNamespace>ActiproSoftware.Tools.Builds</RootNamespace>
		<StartupObject>ActiproSoftware.Tools.Builds.Build</StartupObject>

		<AssemblyName>Avalonia-Build</AssemblyName>
		<Product>Avalonia Controls Open-Source Build</Product>
		<Title>Actipro Avalonia Controls Open-Source Build</Title>
		<Description>Actipro Avalonia Controls Open-Source Build</Description>

		<RootNamespace>ActiproSoftware.Tools.Builds</RootNamespace>

		<GeneratePackageOnBuild>false</GeneratePackageOnBuild>

		<NoWarn>CS0649;CS0169</NoWarn>
		<NukeRootDirectory></NukeRootDirectory>
		<NukeScriptDirectory></NukeScriptDirectory>
		<NukeTelemetryVersion>1</NukeTelemetryVersion>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Nuke.Common" Version="8.1.4" />
	</ItemGroup>

</Project>
